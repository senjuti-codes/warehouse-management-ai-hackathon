# Copy this file to .env and fill in local values. Never commit real secrets.

NODE_ENV=development
PORT=8000

# Defaults to the repository workbook when omitted.
WORKBOOK_PATH=../data/Warehouse_AI_Hackathon_Synthetic_Dataset_FINAL.xlsx

# LLMaaS integration. Keep the API key in backend/.env or the process environment.
LLMAAS_BASE_URL=https://llmaas.internal.example.com/v1
LLMAAS_API_KEY=replace-with-your-llmaas-key
LLMAAS_MODEL=llama-model-name

# Optional OpenAI-compatible settings.
LLMAAS_TIMEOUT_MS=30000
