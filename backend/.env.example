# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real credentials.

ENVIRONMENT=local

# Comma-separated list of origins allowed to call this API. Add your
# deployed Next.js URL here alongside localhost once you deploy to EC2.
CORS_ORIGINS=http://localhost:3000

# Matches docker-compose.yml's postgres service. If running the backend
# outside Docker against the same compose stack, use localhost instead of
# the service name "postgres" as the host.
DATABASE_URL=postgresql+psycopg2://warehouse:warehouse@postgres:5432/warehouse_ai

# The dataset's fixed "as-of" date. All overdue/expired/stale checks compare
# against this, never against today's real date -- keep this in sync with
# whatever copy of the workbook you're currently testing against.
DATASET_SNAPSHOT_DATE=2026-09-05

# --- LLMaaS ---
# Fill these in once you have the real endpoint + key. See
# app/llm/client.py for what happens if the gateway turns out not to be
# OpenAI-compatible.
LLM_BASE_URL=https://llmaas.internal.example.com/v1
LLM_API_KEY=changeme
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
